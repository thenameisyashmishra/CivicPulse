# Copy to .env and adjust for your environment.

# SQLite by default (zero-setup). Swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://civicpulse:password@localhost:5432/civicpulse
DATABASE_URL=sqlite:///./civicpulse.db

# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Directory where uploaded evidence photos are stored
UPLOAD_DIR=./uploads

# Comma-separated list of allowed CORS origins (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Max distance (meters) an evidence photo's GPS can be from the project's
# registered coordinates before it's flagged as outside the project boundary.
GEOFENCE_RADIUS_METERS=500
