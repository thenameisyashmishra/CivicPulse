# Root Environment Config Example
# -------------------------------------------------------------
# Copy this file to .env at the root or distribute to backend/ and frontend/

# Backend Config (backend/.env)
DATABASE_URL=sqlite:///./civicpulse.db
JWT_SECRET_KEY=generate_a_random_hex_key_for_jwt_signing_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEOFENCE_RADIUS_METERS=100.0

# Frontend Config (frontend/.env)
# The React development proxy forwards requests to http://localhost:8000
VITE_API_URL=/api
